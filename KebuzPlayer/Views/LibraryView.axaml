<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KebuzPlayer.ViewModels"
             xmlns:models="using:KebuzPlayer.Models"
             xmlns:v="using:KebuzPlayer.Views"
             xmlns:c="using:KebuzPlayer.Controls"
             x:Class="KebuzPlayer.Views.LibraryView"
             x:Name="Root"
             x:DataType="vm:LibraryViewModel">

    <UserControl.Styles>
        <Style Selector="Panel.isHidden">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="Grid.isHidden">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="TextBlock.hiddenTag">
            <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="LetterSpacing" Value="0.8" />
            <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <Border Grid.Row="0" Height="56" Margin="20,10,20,0"
                IsVisible="{Binding VizStripVisible}"
                BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1">
            <c:VisualizerPanel Placement="Library" Margin="0,0,0,6" />
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" Margin="20,14,20,14">
            <Button Grid.Column="0" Classes="primary" Content="{DynamicResource Folder.Add}"
                    Command="{Binding AddFolderCommand}" />
            <Button Grid.Column="1" Classes="ghost" Content="{DynamicResource Library.Refresh}" Margin="8,0,0,0"
                    Command="{Binding RescanCommand}" />
            <Button Grid.Column="2" Classes="ghost" Content="{DynamicResource Library.GenerateCovers}" Margin="8,0,0,0"
                    Command="{Binding GenerateCoversCommand}" />
            <Button Grid.Column="3" Classes="ghost" Content="{DynamicResource Library.RegenerateSelected}" Margin="8,0,0,0"
                    Command="{Binding RegenerateSelectedCommand}" />
            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4"
                        VerticalAlignment="Center" Margin="0,0,12,0">
                <c:KebuzComboBox Width="150" FontFamily="{StaticResource FontMono}" FontSize="12"
                          VerticalAlignment="Center" Margin="0,0,4,0"
                          ItemsSource="{Binding SortOptions}"
                          SelectedItem="{Binding SortOption}">
                    <c:KebuzComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:TrackSortOption">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </c:KebuzComboBox.ItemTemplate>
                </c:KebuzComboBox>
                <Button Classes="ctrl" Command="{Binding ToggleSortDirectionCommand}"
                        Margin="0,0,4,0" ToolTip.Tip="{DynamicResource Sort.Direction}">
                    <Panel Width="12" Height="14">
                        <Path Data="M6,1 L6,13 M6,13 L2.5,9.5 M6,13 L9.5,9.5" Classes="stroke"
                              Stretch="None" IsVisible="{Binding !SortDescending}" />
                        <Path Data="M6,13 L6,1 M6,1 L2.5,4.5 M6,1 L9.5,4.5" Classes="stroke"
                              Stretch="None" IsVisible="{Binding SortDescending}" />
                    </Panel>
                </Button>
                <Button Classes="ctrl" Classes.active="{Binding ShowHidden}"
                        Command="{Binding ToggleShowHiddenCommand}"
                        Margin="0,0,8,0" ToolTip.Tip="{DynamicResource Library.ShowHidden}">
                    <Path Data="M7,2.5 C11,2.5 13.5,7 13.5,7 C13.5,7 11,11.5 7,11.5 C3,11.5 0.5,7 0.5,7 C0.5,7 3,2.5 7,2.5 Z M7,4.8 A2.2,2.2 0 1 0 7,9.2 A2.2,2.2 0 1 0 7,4.8 Z"
                          Stretch="None" />
                </Button>
                <Button Classes="ctrl" Classes.active="{Binding IsTableMode}"
                        Command="{Binding SetViewModeCommand}" CommandParameter="Table"
                        ToolTip.Tip="{DynamicResource View.Table}">
                    <Path Data="M0,1 L14,1 14,3.4 0,3.4 Z M0,5.8 L14,5.8 14,8.2 0,8.2 Z M0,10.6 L14,10.6 14,13 0,13 Z" Stretch="None" />
                </Button>
                <Button Classes="ctrl" Classes.active="{Binding IsGridMode}"
                        Command="{Binding SetViewModeCommand}" CommandParameter="Grid"
                        ToolTip.Tip="{DynamicResource View.Grid}">
                    <Path Data="M0,0 L6,0 6,6 0,6 Z M8,0 L14,0 14,6 8,6 Z M0,8 L6,8 6,14 0,14 Z M8,8 L14,8 14,14 8,14 Z" Stretch="None" />
                </Button>
                <Button Classes="ctrl" Classes.active="{Binding IsCompactMode}"
                        Command="{Binding SetViewModeCommand}" CommandParameter="Compact"
                        ToolTip.Tip="{DynamicResource View.Compact}">
                    <Path Data="M0,1.5 L14,1.5 14,3 0,3 Z M0,5 L14,5 14,6.5 0,6.5 Z M0,8.5 L14,8.5 14,10 0,10 Z M0,12 L14,12 14,13.5 0,13.5 Z" Stretch="None" />
                </Button>
            </StackPanel>
            <TextBox Grid.Column="6" Classes="search" Width="200" PlaceholderText="{DynamicResource Common.Search}"
                     Text="{Binding SearchText}" />
        </Grid>

        <Border Grid.Row="2" IsVisible="{Binding IsTableMode}"
                BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1">
            <Grid x:Name="HeaderRow" ColumnDefinitions="*,150,170,56,90" Margin="20,0,20,0">
                <Grid.Styles>
                    <Style Selector="TextBlock">
                        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="LetterSpacing" Value="0.8" />
                        <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
                    </Style>
                </Grid.Styles>
                <TextBlock Grid.Column="0" Text="{DynamicResource Column.Title}" Margin="0,0,0,8" />
                <TextBlock Grid.Column="1" Text="{DynamicResource Column.Artist}" Margin="0,0,0,8" />
                <TextBlock Grid.Column="2" Text="{DynamicResource Column.Album}" Margin="0,0,0,8" />
                <TextBlock Grid.Column="3" Text="{DynamicResource Column.Duration}" Margin="0,0,0,8" />
                <TextBlock Grid.Column="4" Text="{DynamicResource Column.Gain}" Margin="0,0,0,8" TextAlignment="Right" />
                <Rectangle Grid.Column="0" Width="1" Fill="{DynamicResource BorderSoft}"
                           HorizontalAlignment="Right" Margin="0,0,5,4" />
                <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource BorderSoft}"
                           HorizontalAlignment="Right" Margin="0,0,5,4" />
                <Rectangle Grid.Column="2" Width="1" Fill="{DynamicResource BorderSoft}"
                           HorizontalAlignment="Right" Margin="0,0,5,4" />
                <Rectangle Grid.Column="3" Width="1" Fill="{DynamicResource BorderSoft}"
                           HorizontalAlignment="Right" Margin="0,0,5,4" />
            </Grid>
        </Border>

        <ListBox Grid.Row="3" x:Name="TracksList"
                 Classes.libTable="{Binding IsTableMode}"
                 Classes.libGrid="{Binding IsGridMode}"
                 Classes.libCompact="{Binding IsCompactMode}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ItemsSource="{Binding Tracks}"
                 SelectionMode="Multiple"
                 SelectionChanged="Tracks_SelectionChanged"
                 DoubleTapped="Rows_DoubleTapped">
            <ListBox.Resources>
                <ItemsPanelTemplate x:Key="ListItemsPanel">
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
                <ItemsPanelTemplate x:Key="GridItemsPanel">
                    <c:JustifiedWrapPanel />
                </ItemsPanelTemplate>
                <DataTemplate x:Key="GridRowTemplate" x:DataType="vm:TrackRow">
                    <Panel Background="Transparent" Classes.isHidden="{Binding Track.IsHidden}">
                        <Panel.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{DynamicResource Track.PreviewCover}" Click="PreviewCover_Click" />
                                <MenuItem Header="{DynamicResource Track.WriteCover}" Click="WriteCover_Click" />
                                <MenuItem Header="{DynamicResource Track.Edit}" Click="EditMetadata_Click" />
                                <MenuItem Header="{DynamicResource Track.BatchEdit}"
                                          Click="BatchEditMetadata_Click" />
                                <MenuItem Header="{DynamicResource Track.AddToPlaylist}" SubmenuOpened="AddToPlaylist_SubmenuOpened">
                                    <MenuItem Header="…" />
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="{DynamicResource Track.Hide}" Click="HideTrack_Click" />
                                <MenuItem Header="{DynamicResource Track.Show}" Click="UnhideTrack_Click" />
                                <Separator />
                                <MenuItem Header="{DynamicResource Track.DeleteFile}" Click="DeleteTrack_Click" />
                            </ContextMenu>
                        </Panel.ContextMenu>
                        <FlyoutBase.AttachedFlyout>
                            <Flyout Placement="Right">
                                <v:CoverPreviewPanel
                                    DataContext="{Binding #Root.((vm:LibraryViewModel)DataContext).Preview}" />
                            </Flyout>
                        </FlyoutBase.AttachedFlyout>
                        <c:TrackCardControl />
                        <Border Background="{DynamicResource Inset2}" CornerRadius="2"
                                Padding="4,1" Margin="4" HorizontalAlignment="Left" VerticalAlignment="Top"
                                IsVisible="{Binding Track.IsHidden}">
                            <TextBlock Classes="hiddenTag" Text="{DynamicResource Track.HiddenTag}" />
                        </Border>
                    </Panel>
                </DataTemplate>
                <DataTemplate x:Key="CompactRowTemplate" x:DataType="vm:TrackRow">
                    <Grid ColumnDefinitions="34,*,56" Background="Transparent"
                          Classes.isHidden="{Binding Track.IsHidden}">
                        <Grid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{DynamicResource Track.PreviewCover}" Click="PreviewCover_Click" />
                                <MenuItem Header="{DynamicResource Track.WriteCover}" Click="WriteCover_Click" />
                                <MenuItem Header="{DynamicResource Track.Edit}" Click="EditMetadata_Click" />
                                <MenuItem Header="{DynamicResource Track.BatchEdit}"
                                          Click="BatchEditMetadata_Click" />
                                <MenuItem Header="{DynamicResource Track.AddToPlaylist}" SubmenuOpened="AddToPlaylist_SubmenuOpened">
                                    <MenuItem Header="…" />
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="{DynamicResource Track.Hide}" Click="HideTrack_Click" />
                                <MenuItem Header="{DynamicResource Track.Show}" Click="UnhideTrack_Click" />
                                <Separator />
                                <MenuItem Header="{DynamicResource Track.DeleteFile}" Click="DeleteTrack_Click" />
                            </ContextMenu>
                        </Grid.ContextMenu>
                        <FlyoutBase.AttachedFlyout>
                            <Flyout Placement="Right">
                                <v:CoverPreviewPanel
                                    DataContext="{Binding #Root.((vm:LibraryViewModel)DataContext).Preview}" />
                            </Flyout>
                        </FlyoutBase.AttachedFlyout>
                        <TextBlock Grid.Column="0" Classes="mono dim" Text="{Binding Number}"
                                   FontSize="11" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,0,10,0">
                            <TextBlock Text="{Binding Track.Title}" FontSize="12"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Classes="mono dim" Text="{Binding Track.Artist}" FontSize="11"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Classes="hiddenTag" Text="{DynamicResource Track.HiddenTag}" IsVisible="{Binding Track.IsHidden}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Classes="mono dim" Text="{Binding Track.DurationFormatted}"
                                   FontSize="11" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListBox.Resources>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:TrackRow">
                    <Grid ColumnDefinitions="*,150,170,56,90" Background="Transparent"
                          Classes.isHidden="{Binding Track.IsHidden}">
                        <Grid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{DynamicResource Track.PreviewCover}" Click="PreviewCover_Click" />
                                <MenuItem Header="{DynamicResource Track.WriteCover}" Click="WriteCover_Click" />
                                <MenuItem Header="{DynamicResource Track.Edit}" Click="EditMetadata_Click" />
                                <MenuItem Header="{DynamicResource Track.BatchEdit}"
                                          Click="BatchEditMetadata_Click" />
                                <MenuItem Header="{DynamicResource Track.AddToPlaylist}" SubmenuOpened="AddToPlaylist_SubmenuOpened">
                                    <MenuItem Header="…" />
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="{DynamicResource Track.Hide}" Click="HideTrack_Click" />
                                <MenuItem Header="{DynamicResource Track.Show}" Click="UnhideTrack_Click" />
                                <Separator />
                                <MenuItem Header="{DynamicResource Track.DeleteFile}" Click="DeleteTrack_Click" />
                            </ContextMenu>
                        </Grid.ContextMenu>
                        <FlyoutBase.AttachedFlyout>
                            <Flyout Placement="Right">
                                <v:CoverPreviewPanel
                                    DataContext="{Binding #Root.((vm:LibraryViewModel)DataContext).Preview}" />
                            </Flyout>
                        </FlyoutBase.AttachedFlyout>
                        <DockPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Classes="hiddenTag" Text="{DynamicResource Track.HiddenTag}" DockPanel.Dock="Right"
                                       Margin="8,0,4,0" IsVisible="{Binding Track.IsHidden}" />
                            <TextBlock Text="{Binding Track.Title}" FontSize="14"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBlock Grid.Column="1" Classes="mono dim" Text="{Binding Track.Artist}"
                                   FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Classes="mono dim" Text="{Binding Track.Album}"
                                   FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Classes="mono dim" Text="{Binding Track.DurationFormatted}"
                                   FontSize="12" VerticalAlignment="Center" />
                        <Border Grid.Column="4" Background="Transparent"
                                PointerWheelChanged="Gain_PointerWheelChanged">
                            <TextBlock Classes="mono dim"
                                       Text="{Binding Track.UserGainOffset, StringFormat='{}{0:+0.0;-0.0;0}'}"
                                       FontSize="12" TextAlignment="Right" VerticalAlignment="Center" />
                        </Border>
                        <Rectangle Grid.Column="0" Width="1" Fill="{DynamicResource RowLine}"
                                   HorizontalAlignment="Right" Margin="0,-9,5,-9" />
                        <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource RowLine}"
                                   HorizontalAlignment="Right" Margin="0,-9,5,-9" />
                        <Rectangle Grid.Column="2" Width="1" Fill="{DynamicResource RowLine}"
                                   HorizontalAlignment="Right" Margin="0,-9,5,-9" />
                        <Rectangle Grid.Column="3" Width="1" Fill="{DynamicResource RowLine}"
                                   HorizontalAlignment="Right" Margin="0,-9,5,-9" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="4"
                BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,0"
                Padding="20,7">
            <TextBlock Classes="mono dim" Text="{Binding StatusText}" FontSize="11" />
        </Border>
    </Grid>
</UserControl>
