        xmlns:c="using:KebuzPlayer.Controls">

    <Style Selector="c|VisualizerPanel">
        <Setter Property="AccentBrush" Value="{DynamicResource Acc}" />
        <Setter Property="Accent2Brush" Value="{DynamicResource Acc2}" />
    </Style>

</Styles>
