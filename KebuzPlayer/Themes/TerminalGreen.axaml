<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:String x:Key="ThemeUnitTag">TERM — PLAYER/07</x:String>
    <x:String x:Key="ThemeDisplayName">Terminal Green</x:String>

    <Color x:Key="BgColor">#FF040704</Color>
    <Color x:Key="SurfaceColor">#FF0C110C</Color>
    <Color x:Key="InsetColor">#FF010301</Color>
    <Color x:Key="Inset2Color">#FF010101</Color>
    <Color x:Key="BorderStrongColor">#FF2D362D</Color>
    <Color x:Key="BorderSoftColor">#FF1C241C</Color>
    <Color x:Key="RowLineColor">#FF101610</Color>
    <Color x:Key="TextColor">#FFCAE7CA</Color>
    <Color x:Key="TextDimColor">#FF6A8A6A</Color>
    <Color x:Key="TextFaintColor">#FF3C543C</Color>
    <Color x:Key="AccColor">#FF4FCC5B</Color>
    <Color x:Key="Acc2Color">#FF00B89A</Color>
    <Color x:Key="BorderStrongA55Color">#8C2D362D</Color>
    <Color x:Key="InsetA55Color">#8C010301</Color>
    <Color x:Key="InsetA70Color">#B2010301</Color>
    <Color x:Key="BorderA60Color">#992D362D</Color>
    <Color x:Key="TextA75Color">#BFCAE7CA</Color>
    <Color x:Key="TextA70Color">#B2CAE7CA</Color>
    <Color x:Key="AccA20Color">#334FCC5B</Color>
    <Color x:Key="AccA15Color">#264FCC5B</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="Inset" Color="{StaticResource InsetColor}" />
    <SolidColorBrush x:Key="Inset2" Color="{StaticResource Inset2Color}" />
    <SolidColorBrush x:Key="BorderStrong" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="BorderSoft" Color="{StaticResource BorderSoftColor}" />
    <SolidColorBrush x:Key="RowLine" Color="{StaticResource RowLineColor}" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextDim" Color="{StaticResource TextDimColor}" />
    <SolidColorBrush x:Key="TextFaint" Color="{StaticResource TextFaintColor}" />
    <SolidColorBrush x:Key="Acc" Color="{StaticResource AccColor}" />
    <SolidColorBrush x:Key="Acc2" Color="{StaticResource Acc2Color}" />
    <SolidColorBrush x:Key="BorderStrongA55" Color="{StaticResource BorderStrongA55Color}" />
    <SolidColorBrush x:Key="InsetA55" Color="{StaticResource InsetA55Color}" />
    <SolidColorBrush x:Key="InsetA70" Color="{StaticResource InsetA70Color}" />
    <SolidColorBrush x:Key="BorderA60" Color="{StaticResource BorderA60Color}" />
    <SolidColorBrush x:Key="TextA75" Color="{StaticResource TextA75Color}" />
    <SolidColorBrush x:Key="TextA70" Color="{StaticResource TextA70Color}" />
    <SolidColorBrush x:Key="AccA20" Color="{StaticResource AccA20Color}" />
    <SolidColorBrush x:Key="AccA15" Color="{StaticResource AccA15Color}" />
</ResourceDictionary>
