<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KebuzPlayer.ViewModels"
             xmlns:c="using:KebuzPlayer.Controls"
             x:Class="KebuzPlayer.Views.VisualizerView"
             x:DataType="vm:VisualizerViewModel">

    <UserControl.Styles>
        <Style Selector="Button#FullscreenButton">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button#FullscreenButton.shown">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </UserControl.Styles>

    <Panel x:Name="Root">
        <c:VisualizerPanel Placement="Tab" Margin="28"
                           IsVisible="{Binding VizEnabled}" />
        <TextBlock Classes="mono dim" Text="{DynamicResource Viz.DisabledInSettings}" FontSize="12"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding !VizEnabled}" />

        <Button x:Name="FullscreenButton" Classes="ctrl"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,14,14,0"
                Click="Fullscreen_Click"
                IsVisible="{Binding VizEnabled}"
                ToolTip.Tip="{DynamicResource Viz.FullscreenTip}">
            <Path Classes="stroke" Stretch="None"
                  Data="M1,5 L1,1 5,1 M11,1 L15,1 15,5 M15,11 L15,15 11,15 M5,15 L1,15 1,11" />
        </Button>
    </Panel>
</UserControl>
